DAEMON_LIST = MASTER, STARTD

# Disable preemption
PREEMPT=FALSE
RANK=0

# Partitionable slots
NUM_SLOTS=1
NUM_SLOTS_TYPE_1=1
SLOT_TYPE_1=cpus=100%,mem=100%,auto
SLOT_TYPE_1_PARTITIONABLE=TRUE

# Disable cgroups
BASE_CGROUP =

# Shutdown startd if idle for too long (seconds)
STARTD_NOCLAIM_SHUTDOWN = 600

# Shutdown the master if the startd exits
MASTER.DAEMON_SHUTDOWN = (STARTD_StartTime =?= 0)

# Only start new jobs a set amount of time (To help with downscaling)
# Time is in seconds
START = MonitorSelfAge < 2 * 60 * 60

# Specify a dedicated scheduler to allow for parallel jobs
# In k8s, this is specified by an environmental variable
# DedicatedScheduler = "DedicatedScheduler@condor-scheduler-77b94566c5-fkbfs"
STARTD_ATTRS = $(STARTD_ATTRS), DedicatedScheduler
